// TEMPLATE. Replace FAMILY_CODE_HERE with the real family code (kept in CODIGO_FAMILIAR.txt, never committed).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Esta colección es el "código familiar". Quien no conozca el nombre no puede leer ni escribir.
    match /FAMILY_CODE_HERE/{foto} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['img', 't', 'n'])
                    && request.resource.data.img is string
                    && request.resource.data.img.size() < 950000
                    && request.resource.data.t is int
                    && (!('n' in request.resource.data) || request.resource.data.n.size() <= 24);
      allow update: if false;
      allow delete: if true;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
